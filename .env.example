APP_NAME=SIHATI
APP_ORGANIZATION_NAME=SIHATI
APP_TAGLINE="Portal Layanan TI"
APP_FOOTER_TEXT="Portal Layanan TI internal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=30
RETENTION_TICKET_YEARS=5
RETENTION_DATA_EXPORT_DAYS=90
RETENTION_APPLICATION_LOG_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sihati
DB_USERNAME=postgres
DB_PASSWORD=
# Optional least-privilege database role. When set, migrations revoke UPDATE/DELETE on audit_logs.
DB_APP_ROLE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Private disk used for ticket attachments; it must not point to public storage.
ATTACHMENT_PRIVATE_DISK=local
# Branding is served through a controlled endpoint; keep this on the private disk.
BRANDING_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Operational monitoring. Production should use Redis for cache locks and queue.
OPS_STORAGE_DISK=local
OPS_STORAGE_WARNING_PERCENT=80
OPS_STORAGE_CRITICAL_PERCENT=90
OPS_STORAGE_ALERT_COOLDOWN_MINUTES=60
OPS_LOG_CHANNEL=ops
OPS_LOG_LEVEL=info
OPS_LOG_DAYS=30
OPS_REQUIRE_SCHEDULER_HEARTBEAT=false
OPS_REQUIRE_BACKUP_STATUS=false
OPS_REQUIRE_STORAGE_CHECK=false
OPS_HEALTH_FAIL_ON_WARNING=false
OPS_QUEUE_MAX_DEPTH=100
OPS_FAILED_JOBS_WARNING_COUNT=0
OPS_BACKUP_FULL_MAX_AGE_SECONDS=90000
OPS_BACKUP_WAL_MAX_AGE_SECONDS=3600
# Set this to a path visible to the app after the backup runner succeeds.
OPS_BACKUP_STATUS_FILE=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
