APP_NAME=SIHATI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DOMAIN=helpdesk.example.org
APP_URL=https://helpdesk.example.org
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=notice
LOG_DAILY_DAYS=30
OPS_LOG_CHANNEL=ops
OPS_LOG_LEVEL=info
OPS_LOG_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sihati
DB_USERNAME=sihati_app
DB_PASSWORD=change-me
DB_APP_ROLE=sihati_app
POSTGRES_DB=sihati
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
ATTACHMENT_PRIVATE_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_CACHE_DB=1

OPS_STORAGE_DISK=local
OPS_STORAGE_WARNING_PERCENT=80
OPS_STORAGE_CRITICAL_PERCENT=90
OPS_STORAGE_ALERT_COOLDOWN_MINUTES=60
OPS_REQUIRE_SCHEDULER_HEARTBEAT=true
OPS_REQUIRE_BACKUP_STATUS=true
OPS_REQUIRE_STORAGE_CHECK=true
OPS_HEALTH_FAIL_ON_WARNING=true
OPS_QUEUE_MAX_DEPTH=100
OPS_FAILED_JOBS_WARNING_COUNT=0
OPS_SCHEDULER_MAX_AGE_SECONDS=180
OPS_BACKUP_FULL_MAX_AGE_SECONDS=90000
OPS_BACKUP_WAL_MAX_AGE_SECONDS=3600
OPS_BACKUP_STATUS_FILE=/var/lib/sihati/backups/backup-status.json
BACKUP_STATUS_HOST_PATH=/opt/sihati/backups

MAIL_MAILER=log
MAIL_FROM_ADDRESS=helpdesk@example.org
MAIL_FROM_NAME="${APP_NAME}"

TLS_EMAIL=infra@example.org
